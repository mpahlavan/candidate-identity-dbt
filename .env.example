# Copy to .env and fill in. .env is gitignored; this template is not.
#   cp .env.example .env
#   set -a && source .env && set +a
#   dbt debug

# --- Required ---------------------------------------------------------------
# Account identifier, e.g. ABCDEFG-HI12345 (Snowsight -> Account -> View account details)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# --- Optional (defaults shown are what a fresh trial gives you) -------------
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_SCHEMA=DEV
